const norm=s=>(s||"").normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase();
const esc=s=>(s||"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const multi=s=>(s||"").split(";").map(x=>x.trim()).filter(x=>x&&x!=="—"&&!x.startsWith("Não especificada"));
DATA.forEach(r=>{r.mm=multi(r.m);r.ee=multi(r.e);r.h=norm([r.n,r.n+"/"+r.y,r.y,r.s,r.a,r.t,r.m,r.e,r.st,r.ev,r.o].join(" "))});
const $=id=>document.getElementById(id);
function fill(id,label,vals){const c={};vals.forEach(v=>c[v]=(c[v]||0)+1);
 $(id).innerHTML='<option value="">'+label+'</option>'+Object.entries(c).sort((a,b)=>b[1]-a[1]).map(([v,n])=>'<option value="'+esc(v)+'">'+esc(v)+' ('+n+')</option>').join("")}
fill("fTema","Todos os temas",DATA.map(r=>r.t));
fill("fSit","Todas as situações",DATA.map(r=>r.st));
fill("fRel","Direta e indireta",DATA.map(r=>r.r));
fill("fMod","Todas as modalidades",DATA.flatMap(r=>r.mm));
fill("fEsp","Todos os espaços",DATA.flatMap(r=>r.ee));
let shown=40,cur=[];
function hl(text,terms){if(!terms.length)return esc(text);const n=norm(text);let rs=[];
 terms.forEach(t=>{let i=0;while((i=n.indexOf(t,i))>-1){rs.push([i,i+t.length]);i+=t.length}});
 rs.sort((a,b)=>a[0]-b[0]);let out="",p=0;
 for(const[a,b]of rs){if(a<p)continue;out+=esc(text.slice(p,a))+"<mark>"+esc(text.slice(a,b))+"</mark>";p=b}
 return out+esc(text.slice(p))}
function cls(s){return s.startsWith("Revogada")?"rev":s.startsWith("Alterada")?"alt":""}
function apply(){
 const terms=norm($("q").value).split(/\s+/).filter(Boolean);
 const t=$("fTema").value,s=$("fSit").value,rl=$("fRel").value,m=$("fMod").value,e=$("fEsp").value;
 const de=parseInt($("fDe").value)||0,ate=parseInt($("fAte").value)||9999,pe=$("fPend").checked;
 cur=DATA.filter(r=>terms.every(x=>r.h.includes(x))&&(!t||r.t===t)&&(!s||r.st===s)&&(!rl||r.r===rl)&&(!m||r.mm.includes(m))&&(!e||r.ee.includes(e))&&r.y>=de&&r.y<=ate&&(!pe||r.p==="Sim"));
 const o=$("sort").value;
 cur.sort((a,b)=>o==="old"?a.y-b.y||a.n-b.n:o==="num"?a.n-b.n:b.y-a.y||b.n-a.n);
 $("count").textContent=cur.length+" de "+DATA.length+" normas";
 render(terms)}
function render(terms){
 const L=$("list");
 if(!cur.length){L.innerHTML='<div class="empty">Nenhuma norma encontrada. Tente menos palavras ou limpe os filtros.</div>';return}
 L.innerHTML=cur.slice(0,shown).map((r,i)=>{const c=cls(r.st);
  const tags=[r.t].concat(r.mm,r.ee).map(esc).join(" · ");
  const det=[["Situação",r.st],["Evidência",r.ev],["Autoria",r.a],["Relevância",r.r],["Pendência de análise",r.p],["Observação",r.o]].filter(x=>x[1]).map(x=>"<dt>"+x[0]+"</dt><dd>"+esc(x[1])+"</dd>").join("");
  return '<article class="item '+c+'"><button aria-expanded="false" data-i="'+i+'"><div class="top"><span class="num">Lei nº '+hl(r.n+"/"+r.y,terms)+'</span><span class="date">'+r.d+'</span><span class="badge '+c+'">'+esc(r.st.split(" (")[0])+'</span></div><p class="sum">'+hl(r.s,terms)+'</p><div class="tags">'+tags+'</div></button><div class="det"><dl>'+det+'</dl><a href="'+esc(r.l)+'" target="_blank" rel="noopener">Abrir texto oficial na Câmara</a></div></article>'}).join("")
  +(cur.length>shown?'<button class="more" id="more">Mostrar mais ('+(cur.length-shown)+' restantes)</button>':"")}
$("list").addEventListener("click",ev=>{
 if(ev.target.id==="more"){shown+=40;render(norm($("q").value).split(/\s+/).filter(Boolean));return}
 const b=ev.target.closest(".item>button");if(!b)return;
 const a=b.parentElement;a.classList.toggle("open");b.setAttribute("aria-expanded",a.classList.contains("open"))});
["q","fTema","fSit","fRel","fMod","fEsp","fDe","fAte","fPend","sort"].forEach(id=>$(id).addEventListener("input",()=>{shown=40;apply()}));
$("clear").onclick=()=>{["q","fTema","fSit","fRel","fMod","fEsp","fDe","fAte"].forEach(id=>$(id).value="");$("fPend").checked=false;shown=40;apply()};
apply();
