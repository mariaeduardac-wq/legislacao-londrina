<style>
:root{--bg:#f4f6f2;--surface:#fff;--ink:#16231b;--muted:#566359;--line:#d5ddd6;--green:#1f6b45;--green-soft:#e1efe6;--red:#a23b2a;--red-soft:#f7e3df;--amber:#8a5d00;--amber-soft:#f8ecd0;--mark:#fff1a8;--on-green:#fff;
