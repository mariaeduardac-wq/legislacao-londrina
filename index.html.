:root[data-theme="dark"]{--bg:#111a14;--surface:#18241c;--ink:#e8efe9;--muted:#9fb0a4;--line:#2d3d32;--green:#5fbf8a;--green-soft:#1d3a29;--red:#ef9a8a;--red-soft:#3b1f1a;--amber:#e8bf62;--amber-soft:#382c0f;--mark:#5a4b00;--on-green:#0d1a12;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 "Source Sans 3",system-ui,sans-serif}
header{background:var(--green);color:var(--on-green);padding:28px 20px 24px}
.wrap{max-width:1100px;margin:0 auto}
h1{font:700 clamp(1.6rem,4vw,2.3rem)/1.15 Bitter,Georgia,serif;margin:0 0 6px}
header p{margin:0;opacity:.9;max-width:60ch}
.search{margin-top:18px}
.search input{width:100%;font:inherit;font-size:1.1rem;padding:14px 16px;border:2px solid transparent;border-radius:8px;background:var(--surface);color:var(--ink)}
.search input:focus{outline:3px solid #ffd54a;outline-offset:1px}
main.wrap{display:grid;grid-template-columns:260px 1fr;gap:24px;padding:20px}
aside{align-self:start;position:sticky;top:12px}
.f{margin-bottom:14px}
.f label{display:block;font-weight:600;font-size:.9rem;margin-bottom:4px}
.f select,.f input[type=number]{width:100%;font:inherit;padding:8px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--ink)}
.yr{display:flex;gap:8px}
.chk{display:flex;gap:8px;align-items:center;font-size:.95rem;margin-bottom:14px}
button{font:inherit;cursor:pointer}
.ghost{background:none;border:1px solid var(--line);color:var(--ink);padding:8px 12px;border-radius:6px;width:100%}
.bar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}
.bar strong{font-size:1.05rem}
.bar select{font:inherit;padding:6px;border:1px solid var(--line);border-radius:6px;background:var(--surface);color:var(--ink)}
.item{background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--green);border-radius:6px;margin-bottom:10px}
.item.rev{border-left-color:var(--red)}.item.alt{border-left-color:var(--amber)}
.item>button{all:unset;display:block;width:100%;box-sizing:border-box;padding:12px 14px;cursor:pointer}
.item>button:focus-visible{outline:3px solid var(--green);outline-offset:-3px}
.top{display:flex;gap:10px;align-items:baseline;flex-wrap:wrap;margin-bottom:4px}
.num{font:700 1.05rem Bitter,Georgia,serif}
.date{color:var(--muted);font-size:.9rem}
.badge{font-size:.8rem;font-weight:600;padding:1px 8px;border-radius:99px;background:var(--green-soft);color:var(--green)}
.badge.rev{background:var(--red-soft);color:var(--red)}.badge.alt{background:var(--amber-soft);color:var(--amber)}
.sum{margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.open .sum{display:block}
.tags{margin-top:8px;font-size:.88rem;color:var(--muted)}
.det{display:none;padding:0 14px 14px;border-top:1px dashed var(--line);font-size:.95rem}
.open .det{display:block}
.det dl{display:grid;grid-template-columns:max-content 1fr;gap:4px 14px;margin:12px 0}
.det dt{font-weight:600;color:var(--muted)}.det dd{margin:0}
.det a{color:var(--green);font-weight:600}
mark{background:var(--mark);color:inherit;border-radius:2px}
.empty{padding:40px 10px;text-align:center;color:var(--muted)}
.more{display:block;margin:16px auto;padding:10px 22px;border:1px solid var(--green);background:none;color:var(--green);border-radius:6px;font-weight:600}
@media (max-width:800px){main.wrap{grid-template-columns:1fr}aside{position:static}}
</style>
</head>
